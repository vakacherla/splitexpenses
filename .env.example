# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase dashboard under Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push public key (not secret — safe in the frontend bundle). Generate
# with `npx web-push generate-vapid-keys`; the matching private key goes
# server-side only, as the VAPID_PRIVATE_KEY Edge Function secret (see
# README, "Set up settle-up reminders").
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Where a suspended person's "Email the administrator" link goes. Optional:
# defaults to admin@splitexpense.com. Set it here and in the hosting
# provider's environment variables to override.
# VITE_ADMIN_CONTACT_EMAIL=admin@splitexpense.com

# The address invite links are built on, for example https://splitexpenses.example
# (no trailing slash). Leave empty to use whatever address the app is opened on.
# Set it once the app has its own domain; links made earlier keep working as long
# as the old address redirects.
VITE_PUBLIC_APP_URL=

# Cloudflare Turnstile site key (public). Leave unset for the real key. A Cloudflare
# TEST key (1x00000000000000000000AA) may only be set for the Vercel *Preview*
# environment of a staging copy; a production build refuses to build with one. See STAGING.md.
# VITE_TURNSTILE_SITE_KEY=
